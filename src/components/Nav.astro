---
import { site, menu, parcours, reussites, competences } from '../contenu';
import { type Lang, t, home, reussitePath, langs } from '../lib/i18n';

interface Props { lang: Lang; alts: Record<Lang, string>; accueil: boolean }
const { lang, alts, accueil } = Astro.props;
const h = (id: string) => (accueil ? `#${id}` : `${home(lang)}#${id}`);

const groupes = [
  {
    label: t(menu.aPropos, lang), href: h('a-propos'),
    items: [
      { label: t(menu.quiJeSuis, lang), href: h('a-propos') },
      { label: t(menu.enBref, lang), href: h('en-bref') },
    ],
  },
  {
    label: t(menu.parcours, lang), href: h('parcours'),
    items: parcours.etapes.map((e) => ({ label: `${e.annee} · ${t(e.lieu, lang).split(',')[0]}`, href: h(`etape-${e.id}`) })),
  },
  {
    label: t(menu.reussites, lang), href: h('reussites'),
    items: reussites.liste.map((r) => ({ label: t(r.titre, lang), href: reussitePath(lang, r.slug) })),
  },
  {
    label: t(menu.competences, lang), href: h('competences'),
    items: [
      { label: t(competences.sousTitres.competences, lang), href: h('competences') },
      { label: t(competences.sousTitres.outils, lang), href: h('outils') },
      { label: t(competences.sousTitres.langues, lang), href: h('langues') },
    ],
  },
];
---
<header class="nav sur-noir" data-nav>
  <div class="nav-in">
    <a class="logo" href={home(lang)} aria-label={site.nom}>Catherine <i>Caristo</i></a>

    <nav class="menu" aria-label="Menu">
      <ul class="groupes">
        {groupes.map((g, gi) => (
          <li class="groupe">
            <a class="g-lien" href={g.href}>{g.label}</a>
            <button class="g-fleche" type="button" aria-expanded="false" aria-controls={`sous-${gi}`}>
              <span class="sr-only">{g.label}</span>
            </button>
            <ul class="sous" id={`sous-${gi}`}>
              {g.items.map((it) => <li><a href={it.href}>{it.label}</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </nav>

    <div class="droite">
      <ul class="langues" aria-label="Langue">
        {langs.map((l) => (
          <li><a href={alts[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a></li>
        ))}
      </ul>
      <a class="btn btn-clair cta" href={h('contact')}>{t(menu.contact, lang)}</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu-mobile" data-burger>
        <span class="burger-txt" data-ouvrir={t(menu.ouvrir, lang)} data-fermer={t(menu.fermer, lang)}>{t(menu.ouvrir, lang)}</span>
      </button>
    </div>
  </div>

  <div class="mobile" id="menu-mobile" data-mobile hidden>
    <ul>
      {groupes.map((g) => (
        <li>
          <a class="m-grand" href={g.href}>{g.label}</a>
          <ul class="m-sous">
            {g.items.map((it) => <li><a href={it.href}>{it.label}</a></li>)}
          </ul>
        </li>
      ))}
      <li><a class="m-grand" href={h('contact')}>{t(menu.contact, lang)}</a></li>
    </ul>
    <ul class="m-langues">
      {langs.map((l) => <li><a href={alts[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a></li>)}
    </ul>
  </div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; }
  .nav-in {
    height: var(--nav-h); display: flex; align-items: center; justify-content: space-between;
    gap: 24px; padding-inline: var(--pad); background: var(--noir); position: relative; z-index: 2;
  }
  .logo { font-family: var(--serif); font-size: 26px; white-space: nowrap; }
  @media (min-width: 900px) { .logo { font-size: 30px; } }

  .menu { display: none; }
  .groupes { display: flex; gap: 6px; }
  .groupe { position: relative; display: flex; align-items: center; }
  .g-lien { font-weight: 800; font-size: 14px; text-transform: uppercase; padding: 10px 2px 10px 10px; }
  .g-fleche { width: 22px; height: 32px; background: none; border: 0; cursor: pointer; position: relative; color: var(--blanc); }
  .g-fleche::after {
    content: ""; position: absolute; left: 6px; top: 11px; width: 6px; height: 6px;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg); opacity: .6; transition: transform .3s var(--ease);
  }
  .sous {
    position: absolute; top: 100%; left: 0; min-width: 260px; padding: 12px 0;
    background: var(--noir); border-top: 2px solid var(--bordeaux);
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity .25s var(--ease), transform .25s var(--ease), visibility .25s;
  }
  .sous a { display: block; padding: 9px 20px; font-size: 15px; color: #d6d6d6; transition: color .2s; }
  .sous a:hover { color: var(--blanc); }
  .groupe:hover .sous, .groupe:focus-within .sous, .groupe.ouvert .sous { opacity: 1; visibility: visible; transform: none; }
  .groupe:hover .g-fleche::after, .groupe.ouvert .g-fleche::after { transform: rotate(225deg) translate(-2px, -2px); }

  .droite { display: flex; align-items: center; gap: 22px; }
  .langues { display: none; gap: 12px; font-weight: 800; font-size: 13px; }
  .langues a { opacity: .5; padding: 6px 0; transition: opacity .2s; }
  .langues a:hover, .langues a[aria-current] { opacity: 1; }
  .cta { display: none; min-height: 42px; padding: 11px 22px; font-size: 13px; }

  .burger { background: none; border: 0; color: var(--blanc); font-weight: 800; font-size: 14px; text-transform: uppercase; cursor: pointer; padding: 10px 0; }

  @media (min-width: 1100px) {
    .menu { display: block; }
    .langues { display: flex; }
    .cta { display: inline-flex; }
    .burger { display: none; }
  }

  .mobile {
    position: fixed; inset: var(--nav-h) 0 0 0; background: var(--noir); color: var(--blanc);
    overflow-y: auto; padding: 24px var(--pad) 48px; z-index: 1;
  }
  .mobile[hidden] { display: none; }
  .m-grand { display: block; font-weight: 900; text-transform: uppercase; letter-spacing: -.03em; font-size: 34px; line-height: 1; padding: 14px 0 8px; }
  .m-sous a { display: block; padding: 6px 0; color: #bdbdbd; font-size: 16px; }
  .m-langues { display: flex; gap: 24px; margin-top: 32px; font-weight: 800; }
  .m-langues a { opacity: .5; padding: 8px 0; }
  .m-langues a[aria-current] { opacity: 1; }
</style>
