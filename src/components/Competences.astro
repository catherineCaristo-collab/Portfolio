---
import { competences } from '../contenu';
import { type Lang, t, rich } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="competences sur-blanc" id="competences">
  <div class="wrap">
    <h2 class="titre titre-moyen" data-split set:html={rich(competences.titre, lang)} />

    <div class="grille">
      <div>
        <h3 class="sous">{t(competences.sousTitres.competences, lang)}</h3>
        <ul class="pastilles">
          {competences.liste.map((c, i) => (
            <li class:list={['pastille', { fort: c.fort }]} style={`--d:${(i % 5) * -1.3}s`} data-fade>{t(c.nom, lang)}</li>
          ))}
        </ul>
      </div>
      <div class="cote">
        <div id="outils">
          <h3 class="sous">{t(competences.sousTitres.outils, lang)}</h3>
          <ul class="liste">
            {competences.outils.map((o) => <li data-fade>{o}</li>)}
          </ul>
        </div>
        <div id="langues">
          <h3 class="sous">{t(competences.sousTitres.langues, lang)}</h3>
          <ul class="liste">
            {competences.langues.map((l) => <li data-fade><span>{t(l.nom, lang)}</span><i>{t(l.niveau, lang)}</i></li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .competences { padding-block: clamp(90px, 11vw, 160px); }
  .grille { display: grid; gap: 56px; margin-top: clamp(48px, 6vw, 80px); }
  @media (min-width: 900px) { .grille { grid-template-columns: 1.5fr 1fr; gap: 7vw; } }
  .sous { font-weight: 800; font-size: 14px; text-transform: uppercase; color: var(--gris); margin-bottom: 20px; }
  .pastilles { display: flex; flex-wrap: wrap; gap: 10px 10px; }
  .pastille {
    background: var(--gris-clair); border-radius: 999px; padding: 12px 22px;
    font-weight: 600; font-size: clamp(16px, 1.3vw, 19px);
  }
  .pastille.fort { background: var(--bordeaux); color: var(--blanc); }
  :global(.js-motion) .pastille.vu { animation: flotte 6s ease-in-out infinite; animation-delay: var(--d); }
  @keyframes flotte { 0%, 100% { translate: 0 0; } 50% { translate: 0 -4px; } }

  .cote { display: grid; gap: 48px; }
  .liste li {
    display: flex; justify-content: space-between; gap: 16px; padding: 14px 0;
    border-bottom: 1px solid #e6e4e0; font-weight: 600; font-size: 18px;
  }
  .liste li:first-child { border-top: 1px solid #e6e4e0; }
  .liste i { font-family: var(--serif); font-weight: 400; font-size: 20px; color: var(--bordeaux); }
</style>
