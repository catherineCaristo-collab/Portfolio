---
import { Image } from 'astro:assets';
import photo from '../assets/catherine.jpg';
import { site, hero } from '../contenu';
import { type Lang, t, rich } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const cv = site.cv[lang];
---
<section class="hero sur-blanc" id="haut">
  <div class="wrap">
    <p class="qui" data-fade><b>{site.nom}</b> <span>{site.titre}</span></p>
    <h1 class="titre" data-split set:html={rich(hero.phrase, lang)} />
    <div class="ctas" data-fade>
      <a class="btn" href="#contact">{t(hero.boutonContact, lang)}</a>
      {cv && <a class="lien" href={cv} download>{t(hero.boutonCv, lang)}</a>}
    </div>

    <div class="rangee">
      <figure class="tuile photo" data-fade>
        <Image src={photo} alt={site.nom} widths={[360, 520, 720]} sizes="(min-width: 900px) 32vw, 90vw" loading="eager" />
        <figcaption class="etq"><span>{site.prenom}</span><span>{t(site.ville, lang)}</span></figcaption>
      </figure>
      <a class="tuile tx tx-bordeaux" href="#parcours" data-fade>
        <span class="tx-texte"><b>{t(hero.visuel2.grand, lang)}</b><i>{t(hero.visuel2.petit, lang)}</i></span>
        <span class="etq"><span>{t(hero.visuel2.etiquette, lang)}</span><span>{t(hero.visuel2.lien, lang)}</span></span>
      </a>
      <a class="tuile tx tx-vert" href="#reussites" data-fade>
        <span class="tx-texte"><b>{t(hero.visuel3.grand, lang)}</b><i>{t(hero.visuel3.petit, lang)}</i></span>
        <span class="etq"><span>{t(hero.visuel3.etiquette, lang)}</span><span>{t(hero.visuel3.lien, lang)}</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: calc(var(--nav-h) + clamp(56px, 9vw, 120px)); padding-bottom: clamp(48px, 6vw, 90px); }
  .qui { font-size: 17px; margin-bottom: clamp(20px, 2.2vw, 30px); }
  .qui b { font-weight: 600; }
  .qui span { color: var(--gris); }
  @media (max-width: 600px) { .qui span { display: block; } }
  h1 { max-width: 13.5em; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 30px; margin-top: clamp(28px, 3vw, 44px); }

  .rangee { display: grid; gap: 14px; margin-top: clamp(56px, 7.5vw, 110px); }
  @media (min-width: 760px) { .rangee { grid-template-columns: repeat(3, 1fr); gap: 18px; } }
  .tuile { position: relative; display: block; aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden; color: var(--blanc); }
  @media (min-width: 760px) { .tuile { aspect-ratio: auto; height: clamp(360px, 33vw, 520px); } }
  .photo { background: var(--noir); }
  .photo :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%;
    filter: grayscale(1) contrast(1.08); transition: transform 1.2s var(--ease);
  }
  .tuile:hover :global(img) { transform: scale(1.03); }
  .photo::after { content: ""; position: absolute; inset: 55% 0 0 0; background: linear-gradient(transparent, rgba(0,0,0,.55)); }
  .etq {
    position: absolute; left: 22px; right: 22px; bottom: 20px; z-index: 2;
    display: flex; justify-content: space-between; gap: 12px; font-size: 15px;
  }
  .etq > span:first-child { font-weight: 800; text-transform: uppercase; }
  .etq > span:last-child { font-weight: 600; }
  a.tuile .etq > span:last-child { border-bottom: 1.5px solid transparent; transition: border-color .3s; }
  a.tuile:hover .etq > span:last-child { border-color: currentColor; }
</style>
