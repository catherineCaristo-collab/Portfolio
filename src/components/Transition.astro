---
import { transition } from '../contenu';
import { type Lang, t, rich } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<!-- Deux grands mots s'écartent pendant que le visuel bordeaux grandit jusqu'à remplir l'écran -->
<section class="morph sur-blanc" data-pin="morph" aria-label={t(transition.message, lang).replace(/\*/g, '')}>
  <div class="scene">
    <div class="panneau tx-bordeaux" aria-hidden="true"></div>
    <p class="message" set:html={rich(transition.message, lang)} />
    <span class="mot gauche" aria-hidden="true">{t(transition.motGauche, lang)}</span>
    <span class="mot droite" aria-hidden="true">{t(transition.motDroite, lang)}</span>
  </div>
</section>

<style>
  /* Version fixe (sans animation) : le visuel plein avec le message */
  .morph { --p: 1; }
  .scene {
    position: relative; height: 100svh; min-height: 520px; overflow: hidden;
    display: grid; place-items: center;
  }
  .panneau {
    position: absolute; inset: 0;
    /* p = 0 : petit rectangle au centre ; p = 1 : plein écran */
    --e: clamp(0, calc(var(--p) * 1.25), 1);
    clip-path: inset(calc((1 - var(--e)) * var(--iy)) calc((1 - var(--e)) * var(--ix)) round calc((1 - var(--e)) * 12px));
    --iy: 41%; --ix: 43%;
  }
  @media (max-width: 760px) { .panneau { --iy: 40%; --ix: 34%; } }
  .message {
    position: relative; z-index: 2; color: var(--blanc); text-align: center; padding: 0 var(--pad);
    font-family: var(--serif); font-size: clamp(40px, 6.4vw, 104px); line-height: 1; letter-spacing: -.01em;
    opacity: clamp(0, calc((var(--p) - .72) * 5), 1);
    transform: translateY(calc((1 - clamp(0, calc((var(--p) - .72) * 5), 1)) * 30px));
  }
  .message :global(em) { font-style: italic; }
  .mot {
    position: absolute; top: 50%; z-index: 3;
    font-weight: 900; text-transform: uppercase; letter-spacing: -.045em; line-height: 1;
    font-size: clamp(44px, 7vw, 128px); color: var(--noir);
    --sortie: calc(clamp(0, var(--p) * 1.3, 1) * 60vw);
    opacity: clamp(0, calc((1 - var(--p) * 1.3) * 3), 1);
  }
  .gauche { right: calc(50% + 8vw); transform: translate(calc(-1 * var(--sortie)), -50%); }
  .droite { left: calc(50% + 8vw); transform: translate(var(--sortie), -50%); }
  @media (max-width: 760px) {
    .mot { font-size: clamp(40px, 13vw, 80px); }
    .gauche { right: auto; left: 50%; top: auto; bottom: calc(50% + 24vh); transform: translate(-50%, calc(-1 * var(--sortie))); }
    .droite { left: 50%; top: calc(50% + 24vh); transform: translate(-50%, var(--sortie)); }
  }

  /* Avec animation : la section devient plus haute et la scène reste collée à l'écran */
  :global(.js-motion) .morph { --p: 0; height: 260vh; }
  :global(.js-motion) .scene { position: sticky; top: 0; }
</style>
